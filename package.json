{
  "name": "uc-mcds-data-platform",
  "version": "1.0.0",
  "description": "University of Canberra MCDS Data Foundation (EBA) - MDAA-based, config-driven Callista to MCDS pipeline",
  "private": true,
  "scripts": {
    "render": "python3 scripts/render_mdaa.py",
    "validate": "python3 scripts/render_mdaa.py --allow-placeholders && python3 scripts/validate_infra.py",
    "synth": "mdaa -a synth",
    "deploy": "mdaa -a deploy",
    "test": "python3 -m pytest -q tests"
  },
  "author": "Cevo Data Engineering",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "devDependencies": {
    "@aws-mdaa/cli": "1.9.0"
  }
}
